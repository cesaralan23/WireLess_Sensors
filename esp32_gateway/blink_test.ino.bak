// blink_test.ino - prueba simple para verificar estabilidad del gateway
const int LED_PIN = 2;

void setup() {
  Serial.begin(115200);
  delay(100);
  Serial.println("blink_test startup");
  pinMode(LED_PIN, OUTPUT);
}

void loop() {
  digitalWrite(LED_PIN, HIGH);
  Serial.println("LED ON");
  delay(500);
  digitalWrite(LED_PIN, LOW);
  Serial.println("LED OFF");
  delay(500);
}